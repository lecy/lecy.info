```{=html}
<div class="feature-grid list">
<% for (const item of items) {
     const links = item.links || [];
     const main = links.length ? links[0].url : null; %>
  <article class="feature" <%= metadataAttrs(item) %>>
    <% if (item.tag) { %><span class="res-tag"><%= item.tag %></span><% } %>
    <h3 class="feature-title listing-title">
      <% if (main) { %><a href="<%- main %>"><%= item.title %></a><% } else { %><%= item.title %><% } %>
    </h3>
    <p class="feature-desc listing-description"><%= item.blurb || item.description %></p>
    <% if (links.length) { %>
    <div class="res-links">
      <% for (const l of links) { %>
        <a class="chip" href="<%- l.url %>"><%= l.label %> <i class="bi bi-arrow-up-right"></i></a>
      <% } %>
    </div>
    <% } %>
  </article>
<% } %>
</div>
```
