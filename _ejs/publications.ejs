```{=html}
<%
const esc = (s) => String(s || "").replace(/&/g, "&amp;").replace(/</g, "&lt;");
const bold = (s) => esc(s).replace(/(Lecy,?\s*(?:J\.\s*D\.|J\.D\.|JD|J\.)?)/g, "<strong>$1</strong>");
const isPdf = (u) => /\.pdf$/i.test(u || "");
%>
<ol class="pub-list list">
<% for (const item of items) { %>
  <li class="pub" <%= metadataAttrs(item) %>>
    <div class="pub-year listing-year"><%= item.year %></div>
    <div class="pub-body">
      <div class="pub-title listing-title"><%= item.title %></div>
      <div class="pub-authors listing-authors"><%= bold(item.authors) %></div>
      <div class="pub-venue">
        <em class="listing-venue"><%= item.venue %></em><% if (item.details) { %>, <%= item.details %><% } %>
        <% if (item.type) { %><span class="pub-type"><%= item.type %></span><% } %>
      </div>
      <% if (item.note) { %><div class="pub-note"><i class="bi bi-award"></i> <%= item.note %></div><% } %>
      <% if (item.links && item.links.length) { %>
      <div class="pub-links">
        <% for (const l of item.links) { %>
          <a class="chip" href="<%- l.url %>"><i class="bi <%= isPdf(l.url) ? 'bi-file-earmark-pdf' : 'bi-box-arrow-up-right' %>"></i> <%= l.label %></a>
        <% } %>
      </div>
      <% } %>
    </div>
  </li>
<% } %>
</ol>
```
